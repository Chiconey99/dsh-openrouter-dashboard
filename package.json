{
  "name": "dsh-openrouter-dashboard",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Persistent OpenRouter usage and balance panel for DeepSeek Harness",
  "main": "./index.js",
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json" },
  "dsh": {
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-sidebar"] },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "license": "MIT",
  "engines": { "node": ">=22.8.0" },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "README.md", "SECURITY.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/client.test.js test/core.test.js test/host.test.js",
    "check": "node --check index.js && node --check core.js && node --check client.js",
    "privacy": "node scripts/privacy-check.mjs"
  }
}
